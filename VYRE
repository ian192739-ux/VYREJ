        Position=UDim2.new(1,-60,0.5,-11),
        Text="",
        BackgroundColor3=settings[name] and Theme.Magenta or Color3.fromRGB(220,210,218),
        BorderSizePixel=0
    },row)
    round(button,15)

    local dot = create("Frame",{
        Size=UDim2.fromOffset(17,17),
        Position=settings[name] and UDim2.new(1,-20,0.5,-8) or UDim2.fromOffset(3,3),
        BackgroundColor3=Color3.new(1,1,1),

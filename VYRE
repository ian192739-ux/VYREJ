-- Selector circular de colores

local function colorPicker(name,callback)
    local row=create("Frame",{
        Size=UDim2.new(1,0,0,45),
        BackgroundColor3=Theme.Panel,
        BorderSizePixel=0
    },content)
    round(row,7)
    outline(row,Color3.fromRGB(245,215,232),1)

    label(row,name,UDim2.new(1,-75,1,0),Theme.Text).Position=UDim2.fromOffset(12,0)

    local preview=create("TextButton",{
        Size=UDim2.fromOffset(38,27),
        Position=UDim2.new(1,-50,0.5,-13),
        Text="",
        BackgroundColor3=callback(),
        BorderSizePixel=0
    },row)
    round(preview,6)
    outline(preview,Theme.Pink,1)

    local wheel=create("Frame",{
        Size=UDim2.fromOffset(180,180),
        Position=UDim2.new(1,-190,0,48),
        BackgroundColor3=Color3.fromRGB(255,248,252),
        BorderSizePixel=0,
        Visible=false,
        ZIndex=10
    },content)
    round(wheel,12)
    outline(wheel,Theme.Pink,2)

    local wheelTitle=label(wheel,"CHOOSE COLOR",UDim2.new(1,-20,0,22),Theme.Magenta,Enum.Font.GothamBold)
    wheelTitle.Position=UDim2.fromOffset(10,5)
    wheelTitle.ZIndex=11

    local colors={
        Color3.fromRGB(255,0,0),
        Color3.fromRGB(255,100,0),
        Color3.fromRGB(255,210,0),
        Color3.fromRGB(100,255,0),
        Color3.fromRGB(0,220,130),
        Color3.fromRGB(0,220,255),
        Color3.fromRGB(0,100,255),
        Color3.fromRGB(100,0,255),
        Color3.fromRGB(190,0,255),
        Color3.fromRGB(255,0,200),
        Color3.fromRGB(255,80,140),
        Color3.fromRGB(255,255,255)
    }

    for i,color in ipairs(colors) do
        local angle=(i-1)*(math.pi*2/#colors)-math.pi/2
        local x=90+math.cos(angle)*53-13
        local y=102+math.sin(angle)*53-13

        local swatch=create("TextButton",{
            Size=UDim2.fromOffset(26,26),
            Position=UDim2.fromOffset(x,y),
            BackgroundColor3=color,
            Text="",
            BorderSizePixel=0,
            ZIndex=12
        },wheel)
        round(swatch,20)
        outline(swatch,Color3.fromRGB(220,190,210),1)

        swatch.MouseButton1Click:Connect(function()
            preview.BackgroundColor3=color
            callback(color)
            wheel.Visible=false
        end)
    end

    preview.MouseButton1Click:Connect(function()
        wheel.Visible=not wheel.Visible
    end)
end

-- Construcción de las pestañas

local function buildTab(tab)
    selectedTab=tab
    clearContent()

    if tab=="MAIN" then
        section("MAIN OPTIONS")
        toggle("Aimbot PC")
        toggle("Aimrizogs")
        toggle("Aimbot Target")
        toggle("ESP Enabled")
        toggle("Show Names")
        toggle("Show Distance")
        toggle("Delete Preview")

    elseif tab=="AIM" then
        section("AIM OPTIONS")
        toggle("Aimbot PC")
        toggle("Aimrizogs")
        toggle("Aimbot Target")
        dropdown("Target Limb",{"Head","UpperTorso","HumanoidRootPart"})
        toggle("Hold Mode")

        section("AIMBOT CONFIG")
        slider("FOV",10,500,120)
        slider("FOV Transparency",0,100,50)
        slider("Max Distance",100,10000,1000)
        slider("Smoothing",1,100,25)
        slider("Prediction",0,100,10)
        toggle("Use Prediction")
        toggle("Team Check")

        section("COLOR SETTINGS")
        colorPicker("FOV Circle Color",function(color)
            if color then Theme.FOV=color end
            return Theme.FOV
        end)

        colorPicker("FOV Lock Color",function(color)
            if color then Theme.Magenta=color end
            return Theme.Magenta
        end)

    elseif tab=="VISUAL" then
        section("VISUAL OPTIONS")
        toggle("ESP Enabled")
        toggle("Show Names")
        toggle("Show Distance")
        dropdown("ESP Mode",{"Name","Distance","Name + Distance"})
        slider("ESP Distance",100,10000,1000)

        colorPicker("ESP Color",function(color)
            if color then Theme.ESP=color end
            return Theme.ESP
        end)

    elseif tab=="DELETER" then
        section("DELETER TEST OPTIONS")
        toggle("Delete Preview")
        dropdown("Preview Mode",{"Single","Multiple","All"})
        slider("Preview Distance",10,500,100)

    elseif tab=="TP" then
        section("TELEPORT TEST OPTIONS")
        dropdown("Destination",{"Spawn","Checkpoint 1","Checkpoint 2"})
        toggle("Teleport Preview")
        label(content,"Conecta esta sección a puntos de prueba de tu propio mapa.",UDim2.new(1,-10,0,35),Theme.Muted)
    end
end

for i,tab in ipairs(tabs) do
    local button=create("TextButton",{
        Size=UDim2.new(1,-16,0,38),
        Position=UDim2.fromOffset(8,42+(i-1)*45),
        Text=tab,
        TextSize=13,
        Font=Enum.Font.GothamBold,
        TextColor3=Theme.Magenta,
        BackgroundColor3=Color3.fromRGB(255,255,255),
        BorderSizePixel=0
    },sidebar)
    round(button,7)
    tabButtons[tab]=button

    button.MouseButton1Click:Connect(function()
        for _,b in pairs(tabButtons) do
            b.BackgroundColor3=Color3.fromRGB(255,255,255)
        end
        button.BackgroundColor3=Color3.fromRGB(255,220,239)
        buildTab(tab)
    end)
end

tabButtons.MAIN.BackgroundColor3=Color3.fromRGB(255,220,239)
buildTab("MAIN")

-- Arrastrar ventana

local dragging=false
local dragStart
local startPos

top.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=true
        dragStart=input.Position
        startPos=main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then
        local delta=input.Position-dragStart
        main.Position=UDim2.new(
            startPos.X.Scale,startPos.X.Offset+delta.X,
            startPos.Y.Scale,startPos.Y.Offset+delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=false
    end
end)


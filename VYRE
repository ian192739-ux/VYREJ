        dot.Position = settings[name] and UDim2.new(1,-20,0.5,-8) or UDim2.fromOffset(3,3)
    end)
end

local function slider(name,min,max,default)
    local value = default

    local row = create("Frame",{
        Size=UDim2.new(1,0,0,60),
        BackgroundColor3=Theme.Panel,
        BorderSizePixel=0
    },content)
    round(row,7)
    outline(row,Color3.fromRGB(245,215,232),1)

    label(row,name,UDim2.new(0.7,0,0,24),Theme.Text).Position=UDim2.fromOffset(12,4)

    local number = label(row,tostring(value),UDim2.fromOffset(55,22),Theme.Magenta,Enum.Font.GothamBold)
    number.Position=UDim2.new(1,-65,0,4)
    number.TextXAlignment=Enum.TextXAlignment.Right

    local bar = create("Frame",{
        Position=UDim2.fromOffset(12,36),
        Size=UDim2.new(1,-24,0,7),
        BackgroundColor3=Color3.fromRGB(240,220,232),
        BorderSizePixel=0
    },row)
    round(bar,5)

    local fill = create("Frame",{
        Size=UDim2.new((value-min)/(max-min),0,1,0),
        BackgroundColor3=Theme.Magenta,
        BorderSizePixel=0
    },bar)
    round(fill,5)

    local knob = create("Frame",{
        Size=UDim2.fromOffset(13,13),
        Position=UDim2.new((value-min)/(max-min),-6,0.5,-6),
        BackgroundColor3=Theme.Magenta,
        BorderSizePixel=0
    },bar)
    round(knob,20)

    local dragging = false

    local function update(x)
        local percent = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        value = math.floor(min+(max-min)*percent)
        fill.Size=UDim2.new(percent,0,1,0)
        knob.Position=UDim2.new(percent,-6,0.5,-6)
        number.Text=tostring(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true
            update(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=false
        end
    end)
end

